# CORS Configuration
# Comma-separated list of allowed origins for CORS
# Default: http://localhost:3000,http://localhost:5173
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# File Upload Configuration
# Maximum file size in MB for Excel uploads
# Default: 50
MAX_FILE_SIZE_MB="50"

# Rate Limiting Configuration
# Maximum number of requests per minute per IP
# Default: 100
RATE_LIMIT_REQUESTS="100"

# OSRM Circuit Breaker Configuration
# Maximum number of retry attempts for OSRM requests
# Default: 3
OSRM_MAX_RETRIES="3"

# Base value for exponential backoff in seconds (1s, 2s, 4s)
# Default: 1.0
OSRM_RETRY_BACKOFF_BASE="1.0"

# Cache failed OSRM requests for this many minutes
# Default: 5
OSRM_FAILURE_CACHE_MINUTES="5"

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL="INFO"
